<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>sh.soml</groupId>
	<artifactId>soml</artifactId>
	<version>0.0.1</version>
	<packaging>jar</packaging>

	<name>SOML</name>
	<description>Read and write SOML, a config format for humans</description>
	<url>https://github.com/soml-lang/soml-java</url>

	<licenses>
		<license>
			<name>MIT</name>
			<url>https://opensource.org/licenses/MIT</url>
		</license>
	</licenses>

	<developers>
		<developer>
			<name>Sindre Sorhus</name>
			<email>sindresorhus@gmail.com</email>
			<url>https://sindresorhus.com</url>
		</developer>
	</developers>

	<scm>
		<url>https://github.com/soml-lang/soml-java</url>
		<connection>scm:git:https://github.com/soml-lang/soml-java.git</connection>
		<developerConnection>scm:git:git@github.com:soml-lang/soml-java.git</developerConnection>
	</scm>

	<properties>
		<maven.compiler.release>25</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<junit.version>6.1.3</junit.version>
		<jackson.version>3.2.4</jackson.version>
		<!-- A fixed time for the entries of the jar, so that a build gives the same bytes every time. `scripts/set-version.sh` updates it. -->
		<project.build.outputTimestamp>2026-10-29T20:35:29Z</project.build.outputTimestamp>
	</properties>

	<dependencies>
		<!-- The nullness annotations of the API, which JSpecify asks to be a normal dependency. -->
		<dependency>
			<groupId>org.jspecify</groupId>
			<artifactId>jspecify</artifactId>
			<version>1.0.1</version>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- Reads the tagged JSON of the conformance suite. -->
		<dependency>
			<groupId>tools.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<version>${jackson.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.16.0</version>
				<configuration>
					<!-- NullAway checks the nullness annotations of the library, with Error Prone, which needs the exports in `.mvn/jvm.config`. Every other Error Prone check is off. -->
					<compilerArgs>
						<arg>-Xlint:all</arg>
						<arg>-Werror</arg>
						<arg>-XDcompilePolicy=simple</arg>
						<arg>--should-stop=ifError=FLOW</arg>
						<arg>-Xplugin:ErrorProne -XepDisableAllChecks -Xep:NullAway:ERROR -XepOpt:NullAway:OnlyNullMarked=true -XepOpt:NullAway:JSpecifyMode=true</arg>
					</compilerArgs>
					<annotationProcessorPaths>
						<path>
							<groupId>com.google.errorprone</groupId>
							<artifactId>error_prone_core</artifactId>
							<version>2.51.0</version>
						</path>
						<path>
							<groupId>com.uber.nullaway</groupId>
							<artifactId>nullaway</artifactId>
							<version>0.14.3</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
				<executions>
					<!-- The tests run in the library's module, and `ComplexityTest` measures CPU time with `java.lang.management`, which the library does not need. NullAway does not check the tests. -->
					<execution>
						<id>default-testCompile</id>
						<configuration>
							<compilerArgs>
								<arg>-Xlint:all</arg>
								<arg>-Werror</arg>
								<arg>--add-modules=java.management</arg>
								<arg>--add-reads=sh.soml=java.management</arg>
							</compilerArgs>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.6.1</version>
				<configuration>
					<argLine>--add-modules=java.management --add-reads=sh.soml=java.management</argLine>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.5.1</version>
			</plugin>
			<!-- A software bill of materials (`target/bom.json` and `target/bom.xml`), which is published with the jar. -->
			<plugin>
				<groupId>org.cyclonedx</groupId>
				<artifactId>cyclonedx-maven-plugin</artifactId>
				<version>2.9.3</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>makeBom</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>3.12.0</version>
				<configuration>
					<!-- Every public type and member has a description. `@param` and `@return` are left out where the description says it. -->
					<doclint>all,-missing</doclint>
					<failOnWarnings>true</failOnWarnings>
				</configuration>
				<!-- Maven Central needs the Javadoc and sources jars. Making them in every build also checks the Javadoc. -->
				<executions>
					<execution>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<version>3.4.0</version>
				<executions>
					<execution>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- Signs the artifacts, and uploads them to Maven Central with `mvn deploy -P release`. See `maintaining.md`. -->
		<profile>
			<id>release</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<version>3.2.8</version>
						<executions>
							<execution>
								<goals>
									<goal>sign</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<version>0.12.0</version>
						<extensions>true</extensions>
						<configuration>
							<publishingServerId>central</publishingServerId>
							<autoPublish>true</autoPublish>
							<waitUntil>published</waitUntil>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
